{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "padding": { "top": 1, "left": 2, "right": 4 },
        "color": { "1": "cyan" }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "cyan",
            "title": "cyan",
            "output": "white"
        }
    },
    "modules": [
        { "type": "os",       "key": "󰻀  os      " },
        { "type": "kernel",   "key": "  kernel  " },
        { "type": "command",  "key": "  host    ", "text": "hostnamectl hostname"},
        { "type": "packages", "key": "  pkgs    ", "format": "{all}" },
        { "type": "command",  "key": "  uptime  ", "text": "uptime -p | cut -d ' ' -f 2-" },
        { "type": "command",  "key": "  memory  ", "text": "free -m | awk 'NR==2{printf \"%.2f GiB / %.2f GiB\",$3/1024,$2/1024}'" },
        { "type": "command",  "key": "  user    ", "text": "echo $USER" },
        { "type": "shell",    "key": "  shell   ", "format": "{pretty-name}" },
        "break",
        "break"
    ]
}